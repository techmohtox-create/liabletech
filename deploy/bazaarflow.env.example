# Copy to bazaarflow.env on the server and fill in. bazaarflow.env is not committed.
# Use Neon's direct (non-pooler) host for this database; Hibernate creates the tables.
OBENOL_DB_URL=jdbc:postgresql://<host-without-pooler>/bazaarflow?sslmode=require
OBENOL_DB_USER=<user>
OBENOL_DB_PASSWORD=<password>
# Any long random string; signs demo login tokens.
OBENOL_JWT_SECRET=<64+ random characters, base64>
