# Copy to .env on the server and fill in. .env is not committed.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<user>
SPRING_DATASOURCE_PASSWORD=<password>

# Email every enquiry and waitlist sign-up to the team (Zoho Mail SMTP).
# Leave these out and the website still works; notifications are just skipped.
SPRING_MAIL_HOST=smtp.zoho.in
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=contact@liabletech.com
SPRING_MAIL_PASSWORD=<Zoho mailbox password>
