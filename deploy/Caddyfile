# Caddy obtains and renews the Let's Encrypt certificate on its own once
# the api A record points at this VM and ports 80/443 are reachable.
api.liabletech.com {
	encode gzip

	# BazaarFlow live demo API: api.liabletech.com/ecommerce/api/... -> bazaarflow:8080/api/...
	handle_path /ecommerce/* {
		reverse_proxy bazaarflow:8080
	}

	# Website BFF: contact form and waitlists.
	handle {
		reverse_proxy bff:8080
	}
}
