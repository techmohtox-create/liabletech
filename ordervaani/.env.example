# Copy this file to .env and fill in the keys. Without them the app still runs:
# staff type lines (and voice-note words) by hand instead.

# Claude reads orders (text, transcripts and photos). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: another Claude model id. Default: claude-opus-5-5
ORDERVAANI_MODEL=

# Sarvam AI turns Hindi and Marathi voice notes into text. Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Optional: speech-to-text model (default saarika:v2.5) and language
# (default "unknown" = detect; or hi-IN, mr-IN).
SARVAM_STT_MODEL=
SARVAM_LANGUAGE=

# Optional: where the database and uploaded files are kept (default ./data).
ORDERVAANI_DATA_DIR=
# Optional: port (default 3100). HOST defaults to 127.0.0.1 so only this computer can open the
# app; there is no login, so do not open it to the network without adding one.
PORT=
HOST=
