{
  "name": "ordervaani",
  "version": "0.1.0",
  "private": true,
  "description": "Turns shopkeepers' voice notes, photos of handwritten lists and text messages into clean orders and a daily order sheet.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
